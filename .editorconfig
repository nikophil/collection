# Mirrors the coding standard in phpcs.xml.dist: tabs by default (PHP, NEON);
# sections below only list what differs from this default.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# composer.json and the XML *.dist configs are space-indented.
[*.{json,xml,dist}]
indent_style = space

# GitHub Actions workflows are space-indented (2).
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: trailing whitespace is significant (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
