{
    "name": "noctud/collection",
    "description": "🗺️ Type-safe, key-preserving, mutable/immutable List/Set/Map for PHP",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.15",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.16",
        "phpbench/phpbench": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "Noctud\\Collection\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Noctud\\Collection\\Tests\\": "tests/",
            "Noctud\\Collection\\Benchmarks\\": "benchmarks/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "qa": [
            "@phpstan",
            "@phpcs",
            "@phpunit"
        ],
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "csf": "phpcbf",
        "phpunit": "phpunit",
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "phpbench run --report=aggregate"
        ],
        "bench:baseline": [
            "Composer\\Config::disableProcessTimeout",
            "phpbench run --tag=baseline --retry-threshold=5 --iterations=10 --report=aggregate"
        ],
        "bench:compare": [
            "Composer\\Config::disableProcessTimeout",
            "phpbench run --ref=baseline --retry-threshold=5 --iterations=10 --report=aggregate"
        ]
    }
}
